# Placeholder values only. Replace these with your own configuration.
# Copy this file to .env for local development; npm start loads it automatically.
# Existing environment variables take precedence. The .env file is optional.
# PORT defaults to 3000 when unset; hosting can supply its own PORT.
MONGODB_URI=mongodb://localhost:27017
# Use a separate database for Assignment 4 to keep Assignment 3 data separate.
MONGODB_DB=dnd_party_tracker_a4
# Generate a random secret of at least 32 characters before starting the app.
SESSION_SECRET=replace-with-a-long-random-secret
# Optional: defaults to 3000.
# PORT=3000
# Set NODE_ENV=production on HTTPS hosting to enable secure session cookies.
# NODE_ENV=production
